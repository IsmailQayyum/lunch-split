# --- Required for every environment ---

# Auth.js
# Generate with: openssl rand -base64 32  (or use any 32+ char random string)
AUTH_SECRET=replace-me

# Allowed Google Workspace domain for sign-in (Workspace `hd` claim)
ALLOWED_EMAIL_DOMAIN=puresquare.com

# Google OAuth — https://console.cloud.google.com -> OAuth client (Web)
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon Postgres — pooled (non-prepared) URL
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Public app URL (no trailing slash) — used in emails + Slack workflow link
APP_URL=http://localhost:3000

# --- Resend (for reminder emails) ---
RESEND_API_KEY=
# A verified sender, e.g. "Lunch Split <lunch@yourdomain>". For dev, use Resend's onboarding sender.
EMAIL_FROM=Lunch Split <onboarding@resend.dev>

# --- Vercel Blob (for receipt photos) ---
BLOB_READ_WRITE_TOKEN=

# --- Slack notifier ---
# Slack webhooks now live on each Group (configure them at /groups). A bill
# posts to its group's webhook only — no global env var. To wire one up, build
# a Slack workflow with trigger "From a webhook", declare a single string
# variable `text`, and have the one step post {{text}} into your channel.
